<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/bs_dark</item>
        <item name="android:statusBarColor">@color/bs_dark</item>
        <item name="android:navigationBarColor">@color/bs_dark</item>
        <item name="android:textColorPrimary">@color/bs_light</item>
        <item name="colorControlNormal">@color/bs_light</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">@color/bs_dark</item>
    </style>

    <style name="Bdx.Btn" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/bs_light</item>
        <item name="android:padding">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Bdx.Btn.Back" parent="Bdx.Btn">
        <item name="android:background">@drawable/btn_flat_gray</item>
        <item name="android:drawableStart">@drawable/ic_arrow_back</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:text">Accueil</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Bdx.Btn.Pad" parent="Bdx.Btn">
        <item name="android:minWidth">72dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:padding">8dp</item>
    </style>
</resources>
