<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="20dp">

    <Button
        android:id="@+id/btn_back_home"
        style="@style/Bdx.Btn.Back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        style="@style/Bdx.Title"
        android:text="Mode démo"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/demo_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Robot sur support. Attente : mix d’effets. Attente mix : les 3 presets dans un ordre tiré au hasard. Pause réglable dans Monitoring. Pas de marche."
        android:textColor="@color/bs_muted"
        android:textSize="14sp" />

    <Button
        android:id="@+id/demo_nod"
        style="@style/Bdx.Btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/btn_flat_yellow"
        android:text="Hochement"
        android:textColor="#212529" />

    <Button
        android:id="@+id/demo_look"
        style="@style/Bdx.Btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_flat_yellow"
        android:text="Regard autour"
        android:textColor="#212529" />

    <Button
        android:id="@+id/demo_curious"
        style="@style/Bdx.Btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_flat_yellow"
        android:text="Curieux"
        android:textColor="#212529" />

    <Button
        android:id="@+id/demo_idle"
        style="@style/Bdx.Btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_flat_cyan"
        android:text="Attente"
        android:textColor="#212529" />

    <Button
        android:id="@+id/demo_idle_mix"
        style="@style/Bdx.Btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_flat_teal"
        android:text="Attente mix"
        android:textColor="#212529" />

    <Button
        android:id="@+id/demo_stop"
        style="@style/Bdx.Btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/btn_flat_red"
        android:text="Stop" />
</LinearLayout>
