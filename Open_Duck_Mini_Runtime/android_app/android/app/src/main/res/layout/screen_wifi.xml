<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="20dp">

    <Button
        android:id="@+id/btn_back_home"
        style="@style/Bdx.Btn.Back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monitoring" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        style="@style/Bdx.Title"
        android:text="Wi‑Fi du robot"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/wifi_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Appui long : réseau par défaut. Liste = 2,4 GHz seulement (le Pi n’entend pas le 5 GHz). Un partage de connexion téléphone doit être en 2,4 GHz."
        android:textColor="@color/bs_muted"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/card_metal"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/wifi_ssid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Réseau —"
            android:textColor="@color/bs_light"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wifi_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="État —"
            android:textColor="@color/bs_muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/wifi_ip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="IP —"
            android:textColor="@color/bs_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/wifi_default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Par défaut · aucun"
            android:textColor="@color/bs_yellow"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/wifi_scan"
        style="@style/Bdx.Btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_flat_blue"
        android:text="Actualiser la liste" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/wifi_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
