<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bs_dark"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="20dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_back_home"
            style="@style/Bdx.Btn.Back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Piloter"
            android:textColor="@color/bs_light"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pilot_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="BLE off"
            android:textColor="@color/bs_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/pilot_video"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/video_slot"
        android:minHeight="120dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Caméra — bientôt\n(affichage, puis IA tablette)"
            android:textColor="@color/bs_muted"
            android:textSize="15sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/pilot_rx_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="RX —"
        android:textColor="@color/bs_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_ant_g"
                    style="@style/Bdx.Btn.Pad"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/btn_flat_gray"
                    android:text="Ant. G" />

                <Button
                    android:id="@+id/btn_tempo_plus"
                    style="@style/Bdx.Btn.Pad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_flat_gray"
                    android:text="Tempo +" />

                <Button
                    android:id="@+id/btn_tempo_minus"
                    style="@style/Bdx.Btn.Pad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_flat_gray"
                    android:text="Tempo −" />

                <Button
                    android:id="@+id/btn_ant_d"
                    style="@style/Bdx.Btn.Pad"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_flat_gray"
                    android:text="Ant. D" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Marche"
                        android:textColor="@color/bs_muted"
                        android:textSize="12sp" />

                    <com.xmaquet.open_duck_mini_runtime.VirtualStickView
                        android:id="@+id/stick_left"
                        android:layout_width="140dp"
                        android:layout_height="140dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <Button
                        android:id="@+id/btn_rythme"
                        style="@style/Bdx.Btn.Pad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/btn_flat_gray"
                        android:text="Rythme" />

                    <Button
                        android:id="@+id/btn_stop"
                        style="@style/Bdx.Btn.Pad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/btn_flat_red"
                        android:minWidth="96dp"
                        android:text="Stop" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rotation"
                        android:textColor="@color/bs_muted"
                        android:textSize="12sp" />

                    <com.xmaquet.open_duck_mini_runtime.VirtualStickView
                        android:id="@+id/stick_right"
                        android:layout_width="140dp"
                        android:layout_height="140dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <RelativeLayout
            android:layout_width="168dp"
            android:layout_height="168dp"
            android:layout_marginStart="8dp">

            <Button
                android:id="@+id/btn_tete"
                style="@style/Bdx.Btn.Pad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_flat_yellow"
                android:text="Tête"
                android:textColor="#212529" />

            <Button
                android:id="@+id/btn_proj"
                style="@style/Bdx.Btn.Pad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_flat_blue"
                android:text="Proj." />

            <Button
                android:id="@+id/btn_son"
                style="@style/Bdx.Btn.Pad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/btn_flat_red"
                android:text="Son" />

            <Button
                android:id="@+id/btn_pause"
                style="@style/Bdx.Btn.Pad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_flat_green"
                android:text="Pause" />
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
