<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_bot_internals" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/metal_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ble_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ble_banner_off"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <View
                android:id="@+id/ble_dot"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/ble_dot_off" />

            <TextView
                android:id="@+id/ble_banner_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.06"
                android:text="BLE DÉCONNECTÉ"
                android:textColor="@color/bs_light"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/ble_banner_connect"
                style="@style/Bdx.Btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_flat_blue"
                android:minHeight="44dp"
                android:text="Connecter" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/screen_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
