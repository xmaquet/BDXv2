<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_metal"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wifi_net_ssid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/bs_light"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wifi_net_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/bs_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wifi_net_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="actuel"
            android:textColor="@color/bs_green"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/wifi_net_default"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="défaut"
            android:textColor="@color/bs_yellow"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
