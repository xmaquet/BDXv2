<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <Button
        android:id="@+id/btn_back_home"
        style="@style/Bdx.Btn.Back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        style="@style/Bdx.Title"
        android:text="Éteindre le robot"
        android:textSize="28sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="4dp"
        android:text="Arrêt propre du Raspberry Pi. L’arrêt OS ne coupe pas la batterie : attendre que le Pi soit mort, puis couper l’alimentation."
        android:textColor="@color/bs_muted"
        android:textSize="14sp" />

    <CheckBox
        android:id="@+id/shutdown_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:buttonTint="@color/bs_red"
        android:text="Je confirme : éteindre le Raspberry Pi"
        android:textColor="@color/bs_light" />

    <Button
        android:id="@+id/shutdown_send"
        style="@style/Bdx.Btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_flat_red"
        android:enabled="false"
        android:text="Éteindre le robot" />

    <TextView
        android:id="@+id/shutdown_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Coche la confirmation, puis éteindre. Filet SSH : sudo poweroff."
        android:textColor="@color/bs_muted"
        android:textSize="13sp" />
</LinearLayout>
